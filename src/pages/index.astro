---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';

const base = import.meta.env.BASE_URL;

const features = [
  {
    icon: `${base}img/featur-tips.png`,
    title: 'Find talent everywhere',
    text: 'Reach qualified professionals across the globe and grow your team without borders.',
  },
  {
    icon: `${base}img/featur-support.png`,
    title: 'Make business international',
    text: 'Open your company to new markets and start selling your services and products worldwide.',
  },
  {
    icon: `${base}img/feature-dua.png`,
    title: 'Discover new suppliers',
    text: 'Connect with reliable partners and suppliers and expand your export operations.',
  },
];
---

<Base title="Exporteller — Linking the world">
  <!-- Hero -->
  <Section class="pt-16 pb-8">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div>
        <span class="inline-block rounded-[var(--radius-sm)] bg-accent-yellow px-3 py-1 text-xs font-semibold text-ink">
          Linking the world
        </span>
        <h1 class="mt-5 text-4xl sm:text-5xl font-semibold leading-[1.08]">
          Build your international brand from
          <span class="text-brand-700">zero to hero.</span>
        </h1>
        <p class="mt-5 max-w-md text-lg text-ink-soft">
          Looking to export your services or products? We can help! Our extensive
          network connects US companies and international businesses so you can grow
          across borders.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#getstarted">Get started</Button>
          <Button href={`${base}support`} variant="secondary">Talk to us</Button>
        </div>
      </div>
      <div class="flex justify-center md:justify-end">
        <img
          src={`${base}img/ilus-dua.png`}
          alt="A team assembling an international strategy together"
          width="560"
          height="610"
          class="w-full max-w-md"
        />
      </div>
    </div>
  </Section>

  <!-- Dos audiencias -->
  <Section class="py-10">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-[var(--radius-lg)] border border-line bg-surface p-8 shadow-[var(--shadow-card)]">
        <span class="text-xs font-semibold uppercase tracking-wide text-brand-700">US Companies</span>
        <h2 class="mt-3 text-2xl font-semibold">Find qualified talent and clients around the world</h2>
        <p class="mt-3 text-ink-soft">
          Tap into a global network of professionals and buyers, and stay ahead in a
          rapidly changing world.
        </p>
      </div>
      <div class="rounded-[var(--radius-lg)] border border-line bg-canvas-alt p-8 shadow-[var(--shadow-card)]">
        <span class="text-xs font-semibold uppercase tracking-wide text-accent-coral">International</span>
        <h2 class="mt-3 text-2xl font-semibold">Sell to US companies and get paid in US Dollars</h2>
        <p class="mt-3 text-ink-soft">
          Offer your services and products to the US market and build a solid global
          strategy from Latin America and beyond.
        </p>
      </div>
    </div>
  </Section>

  <!-- US Companies -->
  <Section class="py-14">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div class="order-2 md:order-1 flex justify-center">
        <img
          src={`${base}img/ilust-14.png`}
          alt="Presenting growth results to a diverse team"
          width="500"
          height="560"
          class="w-full max-w-sm"
        />
      </div>
      <div class="order-1 md:order-2">
        <span class="text-xs font-semibold uppercase tracking-wide text-brand-700">US Companies</span>
        <h2 class="mt-3 text-3xl font-semibold">Stay ahead in a rapidly changing world</h2>
        <p class="mt-4 text-ink-soft">
          We help US companies find the right people, partners and opportunities,
          wherever they are.
        </p>

        <div class="mt-8 grid gap-5 sm:grid-cols-3">
          {features.map((f) => (
            <div>
              <div class="flex h-14 w-14 items-center justify-center rounded-[var(--radius-md)] bg-accent-yellow">
                <img src={f.icon} alt="" width="28" height="28" class="h-7 w-7" />
              </div>
              <h3 class="mt-4 text-base font-semibold">{f.title}</h3>
              <p class="mt-1 text-sm text-ink-soft">{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <!-- International -->
  <Section class="py-14">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wide text-accent-coral">International</span>
        <h2 class="mt-3 text-3xl font-semibold">Create a solid global strategy</h2>
        <p class="mt-4 text-ink-soft">
          From Latin America to the world: reach US companies, get paid in US Dollars,
          and turn your export ambitions into a repeatable, winning strategy.
        </p>
        <div class="mt-7">
          <Button href="#getstarted">Get started</Button>
        </div>
      </div>
      <div class="flex justify-center md:justify-end">
        <img
          src={`${base}img/ilust-13-1.png`}
          alt="Celebrating a business win at the top of a trophy"
          width="500"
          height="560"
          class="w-full max-w-sm"
        />
      </div>
    </div>
  </Section>

  <!-- Working with us -->
  <Section class="py-14">
    <div class="rounded-[var(--radius-lg)] bg-ink px-8 py-14 text-center text-white sm:px-14">
      <span class="text-xs font-semibold uppercase tracking-wide text-brand-300">Working with us</span>
      <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-semibold text-white sm:text-4xl">
        We're re-defining the way companies do business
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-white/70">
        One extensive network, endless connections. Wherever you are, we help you
        link with the world.
      </p>
    </div>
  </Section>

  <!-- Get started -->
  <Section id="getstarted" class="pb-20 pt-6">
    <div class="grid items-center gap-8 rounded-[var(--radius-lg)] border border-line bg-canvas-alt p-10 md:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="text-3xl font-semibold">Ready to go global?</h2>
        <p class="mt-3 max-w-md text-ink-soft">
          Tell us about your project and our team will contact you as soon as possible.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
        <Button href={`${base}support`}>Get started</Button>
        <Button href="mailto:hello@exporteller.com" variant="secondary">hello@exporteller.com</Button>
      </div>
    </div>
  </Section>
</Base>
