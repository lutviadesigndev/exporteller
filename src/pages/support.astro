---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';

const base = import.meta.env.BASE_URL;

/*
 * Formulario estático: no hay servidor que lo procese, así que se envía a un
 * servicio externo. Por defecto usa FormSubmit (https://formsubmit.co) apuntando
 * al mail de la empresa — sin backend ni registro. La PRIMERA vez que llegue un
 * envío, FormSubmit manda un mail de confirmación para activar el endpoint.
 * Para cambiar de servicio (Formspree, Basin, etc.), reemplazá `formAction`.
 */
const formAction = 'https://formsubmit.co/hello@exporteller.com';
---

<Base title="Support — Exporteller">
  <!-- Hero -->
  <Section class="pt-16 pb-6">
    <div class="max-w-2xl">
      <span class="inline-block rounded-[var(--radius-sm)] bg-accent-yellow px-3 py-1 text-xs font-semibold text-ink">
        Support
      </span>
      <h1 class="mt-5 text-4xl font-semibold sm:text-5xl">Our support is here to help you.</h1>
      <p class="mt-4 text-lg text-ink-soft">
        Don't hesitate to contact us. Please fill out the form below, we will
        contact you as soon as possible!
      </p>
    </div>
  </Section>

  <Section class="pb-20 pt-4">
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr]">
      <!-- Formulario -->
      <form
        action={formAction}
        method="POST"
        class="rounded-[var(--radius-lg)] border border-line bg-surface p-8 shadow-[var(--shadow-card)]"
      >
        <!-- Config de FormSubmit (opcional, no se muestra al usuario) -->
        <input type="hidden" name="_subject" value="New contact from exporteller.com" />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-medium text-ink">Your name</span>
            <input
              type="text" name="First name" required
              class="mt-1.5 w-full rounded-[var(--radius-sm)] border border-line bg-canvas px-3 py-2.5 text-ink outline-none focus:border-brand-500"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-ink">Your lastname</span>
            <input
              type="text" name="Last name" required
              class="mt-1.5 w-full rounded-[var(--radius-sm)] border border-line bg-canvas px-3 py-2.5 text-ink outline-none focus:border-brand-500"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-ink">Email</span>
            <input
              type="email" name="Email" required
              class="mt-1.5 w-full rounded-[var(--radius-sm)] border border-line bg-canvas px-3 py-2.5 text-ink outline-none focus:border-brand-500"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-ink">Phone</span>
            <input
              type="tel" name="Phone"
              class="mt-1.5 w-full rounded-[var(--radius-sm)] border border-line bg-canvas px-3 py-2.5 text-ink outline-none focus:border-brand-500"
            />
          </label>
        </div>

        <label class="mt-5 block">
          <span class="text-sm font-medium text-ink">Category</span>
          <select
            name="Category"
            class="mt-1.5 w-full rounded-[var(--radius-sm)] border border-line bg-canvas px-3 py-2.5 text-ink outline-none focus:border-brand-500"
          >
            <option value="" disabled selected>Select the category that best fits your issue or question:</option>
            <option>About the service</option>
            <option>Payment processing</option>
            <option>Feedback</option>
          </select>
        </label>

        <label class="mt-5 block">
          <span class="text-sm font-medium text-ink">Message</span>
          <textarea
            name="Message" rows="5" required
            class="mt-1.5 w-full rounded-[var(--radius-sm)] border border-line bg-canvas px-3 py-2.5 text-ink outline-none focus:border-brand-500"
          ></textarea>
        </label>

        <button
          type="submit"
          class="mt-6 inline-flex items-center justify-center rounded-[var(--radius-sm)] bg-ink px-7 py-3 text-sm font-semibold text-white shadow-[var(--shadow-card)] transition-colors hover:bg-brand-700"
        >
          Submit
        </button>
      </form>

      <!-- Contacto -->
      <aside>
        <h2 class="text-2xl font-semibold">Ready to go global?</h2>
        <p class="mt-2 text-ink-soft">Let's work together!</p>

        <ul class="mt-8 space-y-6 text-sm">
          <li>
            <p class="font-semibold text-ink">Address</p>
            <p class="mt-1 text-ink-soft">24A Trolley Square #1178, Wilmington, DE 19806-3334, U.S.A</p>
          </li>
          <li>
            <p class="font-semibold text-ink">Phone / WhatsApp</p>
            <a href="https://wa.me/5493516133504" class="mt-1 inline-block text-brand-700 hover:underline">
              +54 9 351 613 3504
            </a>
          </li>
          <li>
            <p class="font-semibold text-ink">Email</p>
            <a href="mailto:hello@exporteller.com" class="mt-1 inline-block text-brand-700 hover:underline">
              hello@exporteller.com
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </Section>
</Base>
