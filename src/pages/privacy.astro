---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
---

<Base title="Privacy Policy — Exporteller">
  <Section class="pt-16 pb-20">
    <div class="mx-auto max-w-3xl">
      <span class="inline-block rounded-[var(--radius-sm)] bg-accent-yellow px-3 py-1 text-xs font-semibold text-ink">
        Privacy
      </span>
      <h1 class="mt-5 text-4xl font-semibold sm:text-5xl">Privacy Policy</h1>
      <p class="mt-4 text-lg text-ink-soft">
        At Exporteller, we take your privacy seriously and are committed to protecting
        your personal information.
      </p>

      <div class="prose-legal mt-10 space-y-8">
        <section>
          <h2 class="text-xl font-semibold text-ink">Information we collect</h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-ink-soft">
            <li>Personal information such as name, email address, and phone number.</li>
            <li>Payment information for purchases made on our site.</li>
            <li>Usage data such as IP address, browser type, and device information.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-ink">How we use your information</h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-ink-soft">
            <li>To process orders and payments.</li>
            <li>To communicate about orders and provide customer support.</li>
            <li>To improve our website and services.</li>
            <li>To send promotional emails and newsletters (opt-out available).</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-ink">Data sharing &amp; security</h2>
          <p class="mt-3 text-ink-soft">
            We do not sell or share your personal information with third parties except
            as necessary to process your orders or comply with legal requirements. We
            employ industry-standard security measures to safeguard your information
            against unauthorized access, disclosure, or alteration.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-ink">Policy updates &amp; consent</h2>
          <p class="mt-3 text-ink-soft">
            By using our website, you consent to this policy. We may update it from time
            to time, and any changes will be posted on this page.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-ink">Contact</h2>
          <p class="mt-3 text-ink-soft">
            Questions about this policy can be directed to
            <a href="mailto:hello@exporteller.com" class="text-brand-700 hover:underline">hello@exporteller.com</a>.
          </p>
          <p class="mt-3 text-ink-soft">
            24A Trolley Square #1178, Wilmington, DE 19806-3334, U.S.A ·
            <a href="https://wa.me/5493516133504" class="text-brand-700 hover:underline">+54 9 351 613 3504</a>
          </p>
        </section>
      </div>
    </div>
  </Section>
</Base>
