---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
---

<Base title="Privacy Policy — Exporteller">
  <Section class="pt-16 pb-20">
    <div class="mx-auto max-w-3xl">
      <span class="inline-block rounded-[var(--radius-sm)] bg-accent-yellow px-3 py-1 text-xs font-semibold text-ink">
        Privacy
      </span>
      <h1 class="mt-5 text-4xl font-semibold sm:text-5xl">Privacy Policy</h1>
      <p class="mt-4 text-lg text-ink-soft">
        At Exporteller, we take your privacy seriously and are committed to protecting
        your personal information. This privacy policy outlines the types of
        information we collect, how we use it, and how we protect it.
      </p>

      <div class="mt-10 space-y-8">
        <section>
          <h2 class="text-xl font-semibold text-ink">Information we collect:</h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-ink-soft">
            <li>Personal information such as name, email address, and phone number</li>
            <li>Payment information for purchases made on our site</li>
            <li>Usage data such as IP address, browser type, and device information.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-ink">How we use your information:</h2>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-ink-soft">
            <li>To process orders and payments</li>
            <li>To communicate with you about your orders and provide customer support</li>
            <li>To improve our website and services</li>
            <li>To send promotional emails and newsletters (you can opt-out at any time)</li>
          </ul>
        </section>

        <section class="space-y-4 text-ink-soft">
          <p>
            We do not sell or share your personal information with third parties except
            as necessary to process your orders or comply with legal requirements.
          </p>
          <p>
            We use industry-standard security measures to protect your information from
            unauthorized access, disclosure, or alteration.
          </p>
          <p>
            By using our website, you consent to our privacy policy. We may update this
            policy from time to time, and any changes will be posted on our website. If
            you have any questions or concerns about our privacy policy, please contact
            us at
            <a href="mailto:hello@exporteller.com" class="text-brand-700 hover:underline">hello@exporteller.com</a>.
          </p>
        </section>
      </div>
    </div>
  </Section>
</Base>
