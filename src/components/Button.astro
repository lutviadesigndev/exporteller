---
/**
 * Button.astro — CTA de exporteller: navy sólido, esquinas suaves.
 * Usarlo en vez de clases sueltas mantiene todos los CTAs consistentes.
 * Uso: <Button href="https://...">Get started</Button>
 *      <Button href="..." variant="secondary">Learn more</Button>
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { href, variant = 'primary', class: extra = '' } = Astro.props;
const styles = {
  primary: 'bg-ink text-white hover:bg-brand-700',
  secondary: 'bg-surface text-ink border border-line hover:border-ink',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-[var(--radius-sm)] px-7 py-3 text-sm font-semibold shadow-[var(--shadow-card)] transition-colors',
    styles[variant],
    extra,
  ]}
>
  <slot />
</a>
