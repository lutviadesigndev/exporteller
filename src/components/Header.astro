---
/**
 * Header.astro — navegación compartida (reconstruida de exporteller.com).
 * Los links usan import.meta.env.BASE_URL para funcionar en local y bajo el
 * subdirectorio de GitHub Pages (/exporteller/).
 *
 * Mobile: menú hamburguesa con <details> (sin JavaScript, accesible por teclado).
 */
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}support`, label: 'Support' },
  { href: `${base}terms`, label: 'Terms of Service' },
  { href: `${base}privacy`, label: 'Privacy' },
];
---

<header class="border-b border-line bg-surface/90 backdrop-blur sticky top-0 z-20">
  <div class="mx-auto max-w-6xl px-4 h-20 flex items-center justify-between gap-4">
    <a href={base} class="flex items-center" aria-label="Exporteller — Home">
      <img
        src={`${base}img/logo.png`}
        alt="Exporteller"
        width="180"
        height="40"
        class="h-8 w-auto"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-ink-soft">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-[var(--radius-sm)] px-4 py-2 hover:text-ink hover:bg-canvas-alt transition-colors"
        >{item.label}</a>
      ))}
    </nav>

    <!-- Mobile nav (disclosure sin JS) -->
    <details class="md:hidden relative group">
      <summary
        class="list-none flex h-10 w-10 cursor-pointer items-center justify-center rounded-[var(--radius-sm)] border border-line text-ink [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" /><line x1="6" y1="18" x2="18" y2="6" />
        </svg>
      </summary>
      <nav class="absolute right-0 top-12 w-56 rounded-[var(--radius-md)] border border-line bg-surface p-2 shadow-[var(--shadow-card)]">
        {nav.map((item) => (
          <a
            href={item.href}
            class="block rounded-[var(--radius-sm)] px-4 py-2.5 text-sm font-medium text-ink-soft hover:text-ink hover:bg-canvas-alt transition-colors"
          >{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
